[
    {
        "id": "flow1",
        "type": "tab",
        "label": "Monitoreo Planta",
        "disabled": false,
        "info": "Simula un sensor de temperatura y presión de un tanque industrial, y escribe cada lectura en InfluxDB via su API HTTP (line protocol). No requiere nodos extra instalados: usa http request nativo."
    },
    {
        "id": "inject1",
        "type": "inject",
        "z": "flow1",
        "name": "Cada 5s",
        "props": [
            {
                "p": "payload"
            }
        ],
        "repeat": "5",
        "crontab": "",
        "once": true,
        "onceDelay": 1,
        "topic": "",
        "payload": "",
        "payloadType": "date",
        "x": 140,
        "y": 120,
        "wires": [
            [
                "func-sim"
            ]
        ]
    },
    {
        "id": "func-sim",
        "type": "function",
        "z": "flow1",
        "name": "Simular sensor tanque",
        "func": "// Simula temperatura (°C) y presión (bar) de un tanque industrial\n// con ruido aleatorio alrededor de un punto de operación normal.\nconst temp = 62 + (Math.random() * 4 - 2);\nconst presion = 3.2 + (Math.random() * 0.4 - 0.2);\n\nflow.set('lastTemp', temp);\nflow.set('lastPresion', presion);\n\nmsg.payload = { temperatura: temp, presion: presion };\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 350,
        "y": 120,
        "wires": [
            [
                "func-lineproto",
                "debug1"
            ]
        ]
    },
    {
        "id": "func-lineproto",
        "type": "function",
        "z": "flow1",
        "name": "Formatear line protocol",
        "func": "// Convierte el payload a formato line protocol de InfluxDB v2\nconst t = msg.payload.temperatura.toFixed(2);\nconst p = msg.payload.presion.toFixed(3);\n\nmsg.payload = `tanque,ubicacion=planta1 temperatura=${t},presion=${p}`;\nmsg.headers = {\n    'Content-Type': 'text/plain; charset=utf-8',\n    'Authorization': 'Token dev-token-cambiar-en-produccion'\n};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 610,
        "y": 120,
        "wires": [
            [
                "http-influx"
            ]
        ]
    },
    {
        "id": "http-influx",
        "type": "http request",
        "z": "flow1",
        "name": "POST a InfluxDB",
        "method": "POST",
        "ret": "txt",
        "paytoqs": "ignore",
        "url": "http://influxdb:8086/api/v2/write?org=bariloche-lab&bucket=planta&precision=s",
        "tls": "",
        "persist": false,
        "proxy": "",
        "insecureHTTPParser": false,
        "authType": "",
        "senderr": false,
        "headers": [],
        "x": 850,
        "y": 120,
        "wires": [
            [
                "debug2"
            ]
        ]
    },
    {
        "id": "debug1",
        "type": "debug",
        "z": "flow1",
        "name": "Lectura simulada",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
        "complete": "payload",
        "targetType": "full",
        "statusVal": "",
        "statusType": "auto",
        "x": 610,
        "y": 60,
        "wires": []
    },
    {
        "id": "debug2",
        "type": "debug",
        "z": "flow1",
        "name": "Respuesta InfluxDB",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
        "complete": "true",
        "targetType": "full",
        "statusVal": "",
        "statusType": "auto",
        "x": 1080,
        "y": 120,
        "wires": []
    }
]
